<resources>
    <!-- Android 12+: the system's splash is just the icon's background color; the icon then
         draws itself in the app (ui/LaunchAnimation.kt), so it isn't shown twice. -->
    <style name="Theme.Cas" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowSplashScreenBackground">#FF3E4F3C</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>
</resources>
